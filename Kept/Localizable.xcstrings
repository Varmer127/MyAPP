    "Přesně: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exactly: %@"
          }
        }
      }
    },
    "Přestanete být přátelé a ten člověk tě už nenajde ani ti nepošle žádost. Odblokovat ho můžeš v seznamu přátel." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You'll stop being friends, and that person won't be able to find you or send you a request. You can unblock them in your friends list."
          }
        }
      }
    },
    "Přestanete si sdílet všechno. Znovu se přidat můžete kdykoli." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You'll stop sharing everything. You can add each other again any time."
          }
        }
      }
    },
    "přesunuto" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
