    "ODKLAD BEZ POSTIHU" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PENALTY-FREE POSTPONEMENT"
          }
        }
      }
    },
    "Odklad navíc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
