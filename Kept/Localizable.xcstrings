    "Týden je zapečetěný" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The week is sealed"
          }
        }
      }
    },
    "Týden je zatím prázdný. Přidej něco nahoře." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The week is empty so far. Add something above."
