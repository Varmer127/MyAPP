    "–" : {
      "shouldTranslate" : false
    },
    "—" : {
      "shouldTranslate" : false
    },
    "„%@.“ Teď ještě napíšeš sebekritiku a co uděláš příště. Až to bude potřeba, Kept ti tvoje slova připomene." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@.” Now write an honest self-assessment and what you'll do next time. When it's needed, Kept will remind you of your own words."
          }
        }
      }
    },
    "„%@“" : {
      "shouldTranslate" : false
    },
    "„%@“ jsi jako důvod uvedl %lld×. Pojmenoval jsi problém a stejně se opakoval." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've given “%@” as the reason %lld×. You named the problem and it kept happening."
          }
        }
      }
    },
    "„%@“ už na %@ máš. V aplikaci se tě Kept zeptá, jestli ho tam chceš podruhé." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You already have “%@” on %@. In the app, Kept will ask whether you want it there twice."
          }
        }
      }
    },
    "„%@“ už v označené dny máš. Přidat ho tam můžeš i podruhé, zeptám se tě." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You already have “%@” on the selected days. You can add it a second time; I'll ask you."
          }
        }
      }
    },
    "„%@“ už v ten den máš" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You already have “%@” that day"
          }
        }
      }
    },
    "„%@“ už v tento den máš naplánované" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You already have “%@” planned for this day"
          }
        }
      }
    },
    "„%@“: nesplněno %lld z %lld." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”: missed %lld of %lld."
          }
        }
      }
    },
    "„Splnil jsi to.“" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“You did it.”"
          }
        }
      }
    },
    "„Splnila jsi to.“" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
