          }
        }
      }
    },
    "Přátelé jsou od 15 let. Zkontroluj datum narození. Zbytek Kept funguje bez omezení." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Friends are for ages 15 and up. Check your date of birth. The rest of Kept works without limits."
          }
        }
      }
    },
    "Přátelé jsou od 16 let. Zkontroluj datum narození. Zbytek Kept funguje bez omezení." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Friends are for ages 16 and up. Check your date of birth. The rest of Kept works without limits."
          }
        }
      }
    },
    "Přátelé od" : {
