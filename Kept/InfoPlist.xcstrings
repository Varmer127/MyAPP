{
  "sourceLanguage" : "cs",
  "strings" : {
    "NSCalendarsFullAccessUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kept čte události z kalendáře, aby tě při plánování upozornil, že se úkol kryje s něčím, co už máš domluvené. Nic nezapisuje ani neukládá."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kept reads your calendar events to warn you while planning when a task clashes with something you already have on. It never writes or stores anything."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kept potřebuje fotoaparát, abys mohl vyfotit důkaz splnění úkolu nebo naskenovat QR kód kamaráda."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kept uses the camera so you can take a photo as proof of a finished task or scan a friend's QR code."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kept zamyká tvůj deník pomocí Face ID."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kept locks your diary with Face ID."
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kept čte tvoje kroky, kilometry, aktivní energii, váhu a tréninky, aby je mohl ukázat v přehledu Zdraví a nemusel je zapisovat ručně. Nic do Zdraví nezapisuje."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kept reads your steps, distance, active energy, weight and workouts to show them in its Health overview, so you don't have to type them in. It never writes to Health."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kept potřebuje mikrofon, když si zápis do deníku nadiktuješ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kept uses the microphone when you dictate a diary entry."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kept převádí tvůj nadiktovaný zápis do deníku na text."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kept turns your dictated diary entry into text."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
